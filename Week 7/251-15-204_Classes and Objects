class Student 
{
    int[] scores = new int[5];
    void input() 
    {
        Scanner scan = new Scanner(System.in);
        for (int i = 0; i < 5; i++) 
        {
            scores[i] = scan.nextInt();
        }
    }

    int calculateTotalScore() 
    {
        int total = 0;
        for (int i = 0; i < 5; i++) 
        {
            total += scores[i];
        }
        return total;
    }
}
